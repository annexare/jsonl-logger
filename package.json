{
  "name": "jsonl-logger",
  "version": "0.5.1",
  "description": "Lightweight ESM-only JSON Lines logger with pluggable formatters for Google Cloud Logging, VictoriaLogs, and more",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/preload.ts",
    "./dist/preload.js"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./google-cloud-logging": {
      "bun": "./src/google-cloud-logging.ts",
      "import": "./dist/google-cloud-logging.js",
      "types": "./dist/google-cloud-logging.d.ts"
    },
    "./victoria-logs": {
      "bun": "./src/victoria-logs.ts",
      "import": "./dist/victoria-logs.js",
      "types": "./dist/victoria-logs.d.ts"
    },
    "./intercept": {
      "bun": "./src/intercept.ts",
      "import": "./dist/intercept.js",
      "types": "./dist/intercept.d.ts"
    },
    "./preload": {
      "bun": "./src/preload.ts",
      "import": "./dist/preload.js",
      "types": "./dist/preload.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/google-cloud-logging.ts src/victoria-logs.ts src/intercept.ts src/preload.ts --outdir dist --target node --format esm --minify",
    "build:types": "tsc --emitDeclarationOnly",
    "lint": "biome check --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/bun": "1.3.9",
    "typescript": "5.9.3"
  },
  "keywords": [
    "logger",
    "jsonl",
    "json-lines",
    "esm",
    "structured-logging",
    "google-cloud-logging",
    "victoria-logs",
    "bun",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annexare/jsonl-logger.git"
  },
  "engines": {
    "node": ">=18"
  }
}
